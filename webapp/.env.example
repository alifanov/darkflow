# Connection string for the webapp running as a host process.
# Postgres is published on localhost:5432 by `docker compose up -d` (db service).
# Password must match POSTGRES_PASSWORD in the repo-root .env — both examples
# ship `change-me`, so copying the two files verbatim works out of the box.
DATABASE_URL="postgresql://darkflow:change-me@localhost:5432/darkflow"

# Optional: path/name of the cmux CLI used by the "Fix in cmux" button.
# Defaults to `cmux` on PATH. NOTE: the macOS app ships the real CLI inside the
# bundle — use that, NOT Contents/MacOS/cmux (the GUI binary, which ignores --command).
# CMUX_BIN="/Applications/cmux.app/Contents/Resources/bin/cmux"
